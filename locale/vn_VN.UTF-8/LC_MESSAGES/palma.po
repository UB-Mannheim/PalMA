# Help
#: index.php:1287
msgid ""
"With PalMA, you can share documents, websites and your desktop with your "
"learning group."
msgstr ""
"Với PalMA, bạn có thể chia sẻ tài liệu, trang web và màn hình của mình với "
"nhóm học tập của bạn."

#: index.php:1289
msgid "The PalMA team monitor shows up to four contributions simultaneously."
msgstr "Màn hình nhóm PalMA hiển thị tối đa bốn đóng góp cùng lúc."

#: index.php:1295
msgid "For further information about PalMA in this institution"
msgstr "Để biết thêm thông tin về PalMA trong tổ chức này"

#: index.php:1297
msgid "see here."
msgstr "xem tại đây."

#: index.php:1302
msgid "Connect"
msgstr "Kết nối"

#: index.php:1304
msgid "Team members can join the session at any time with this URL or QR-Code:"
msgstr ""
"Các thành viên trong nhóm có thể tham gia phiên bất cứ lúc nào với URL hoặc "
"mã QR này:"

