#: index.php:1310 index.php:1548
msgid "PIN: "
msgstr "PIN: "

#: index.php:1320
msgid "Use the Add-Section to share content on the PalMA monitor."
msgstr "Sử dụng phần Thêm để chia sẻ nội dung trên màn hình PalMA."

#: index.php:1325
msgid "For PDF files, office files, images or videos use the file section."
msgstr ""
"Đối với tệp PDF, tệp văn phòng, hình ảnh hoặc video, hãy sử dụng phần tệp."

#: index.php:1329
msgid "To display a website use the URL field."
msgstr "Để hiển thị một trang web, hãy sử dụng trường URL."

#: index.php:1333
msgid ""
"To share your desktop in real time download the VNC screen sharing software "
"and"
msgstr ""
"Để chia sẻ màn hình của bạn trong thời gian thực, hãy tải xuống phần mềm "
"chia sẻ màn hình VNC và"

# Referring to the popular operating system
#: index.php:1338
msgid "Windows:"
msgstr "Windows:"

#: index.php:1341
msgid "Run the downloaded file."
msgstr "Chạy tệp đã tải xuống."

#: index.php:1342
msgid "Double-click the name of your PalMA station in the appearing list."
msgstr "Nhấp đúp vào tên của trạm PalMA của bạn trong danh sách xuất hiện."

#: index.php:1344
msgid "Mac:"
msgstr "Mac:"

#: index.php:1346
msgid "CTRL + click the downloaded file and run it."
msgstr "CTRL + nhấp vào tệp đã tải xuống và chạy nó."

#: index.php:1347
msgid "A second window opens, in which you can start &quot;VineServer&quot;."
msgstr ""
"Một cửa sổ thứ hai mở ra, trong đó bạn có thể bắt đầu &quot;VineServer&quot;."

#: index.php:1348
msgid "In the upper left corner, click on &quot;VNC Server&quot;."
msgstr "Ở góc trên bên trái, nhấp vào &quot;VNC Server&quot;."

#: index.php:1349
msgid "Select &quot;Reverse Connection&quot;."
msgstr "Chọn &quot;Reverse Connection&quot;."

#: index.php:1350
msgid "Enter the URL of your PalMA station and click &quot;Connect&quot;."
msgstr "Nhập URL của trạm PalMA của bạn và nhấp vào &quot;Connect&quot;."

#: index.php:1352
msgid "Linux:"
msgstr "Linux:"

#: index.php:1354
msgid "Run the downloaded shell script."
